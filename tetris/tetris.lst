                  ; ======================================================================
                  ;  ТЕТРИС для эхотомоскопа ЭТС-ЭЛ-С (Меделком SLE-101), процессор 80C85
                  ;
                  ;  Загружается в ОЗУ с 0040H через монитор (R или S) и запускается G40.
                  ;  Сборка:  python3 tools/asm8085.py tetris/tetris.asm --lst tetris/tetris.lst
                  ;  Эмулятор: python3 tools/etl_gui.py --hex tetris/tetris.hex --go 40
                  ;
                  ;  Пульт (коды из таблицы 21D4H, блок стрелок 3x3, в центре «+»):
                  ;    ←, →     сдвиг (с автоповтором)
                  ;    ↑, ↗     поворот по часовой, ↖ — против часовой
                  ;    ↓        ускоренное падение
                  ;    +        сбросить фигуру до упора
                  ;    СТАРТ    начать игру / пауза
                  ;    МЕНЮ     выход в основную программу (JMP 2000H)
                  ;
                  ;  Экран: видеоОЗУ, 45 байт в строке, кадр повёрнут на 180°.
                  ;  Байт со столбцом bc (0..44) экранной строки sy (0..306) лежит по адресу
                  ;      0FFFFH - 45*sy - bc,   старший бит — левая точка.
                  ;  Шрифт 8x8 прошивки — 5D91H + 8*код, байты глифа идут сверху вниз.
                  ; ======================================================================
                  
                  ROWB    EQU 45                  ; байт в строке видеоОЗУ
                  FONT    EQU 5D91H               ; шрифт 8x8 в ПЗУ
                  KBTAB   EQU 21D4H               ; коды клавиш пульта: 4 столбца x 8 строк
                  MAIN    EQU 2000H               ; основная программа прибора
                  STACK   EQU 07C0H               ; 07C7-07FF — трамплин и регистры монитора
                  ZEROS   EQU 443AH               ; 26 нулевых байтов в ПЗУ №2 (внутри пиктограммы)
                  
                  ; Задержка кадра: цикл по 24 такта. 2200 -> ~53 тыс. тактов, т.е. ~20 мс
                  ; при 3 МГц вместе с работой игры. Частота процессора на плате точно не
                  ; известна: если игра идёт слишком быстро или медленно — поменять здесь.
                  FDEL    EQU 2200
                  
                  DAS     EQU 10                  ; задержка автоповтора ←/→, кадров
                  ARR     EQU 3                   ; период автоповтора ←/→
                  SDR     EQU 2                   ; период повтора ↓
                  
                  K_UP    EQU 84H
                  K_DOWN  EQU 85H
                  K_LEFT  EQU 87H
                  K_RIGHT EQU 82H
                  K_UL    EQU 86H
                  K_UR    EQU 81H
                  K_DROP  EQU 10H                 ; «+» в центре блока стрелок
                  K_START EQU 1AH
                  K_MENU  EQU 13H
                  
                  ; --- геометрия экрана ---
                  CELLH   EQU 13                  ; клетка 16 точек x 13 строк
                  WELLY   EQU 24                  ; экранная строка верха стакана
                  ; клетка (столбец c=1..10, строка r=0..19): bc = 13+2c, sy = WELLY+13r
                  ROW0    EQU 0FFFFH-ROWB*WELLY-13 ; адрес столбца 0 строки 0 стакана
                  TX0     EQU 3                   ; левая панель: байты 3..13 (11 знаков)
                  PREVA   EQU 0FFFFH-ROWB*40-37   ; окно следующей фигуры: bc 37, sy 40
                  P_SCORE EQU 0FFFFH-ROWB*60-TX0
                  P_LINES EQU 0FFFFH-ROWB*96-TX0
                  P_LEVEL EQU 0FFFFH-ROWB*132-TX0
                  P_MSG1  EQU 0FFFFH-ROWB*164-TX0
                  P_MSG2  EQU 0FFFFH-ROWB*176-TX0
                  
0040                      ORG 0040H               ; 0000-0005 занят монитором, RST-векторы не нужны
                  
                  ; ======================================================================
0040 F3           START:  DI
0041 31 C0 07             LXI SP,STACK
0044 3E 30                MVI A,30H               ; как основная программа: F8 = 30, FA = 80
0046 D3 F8                OUT 0F8H
0048 3E 80                MVI A,80H
004A D3 FA                OUT 0FAH
004C 21 E1 AC             LXI H,0ACE1H
004F 22 1B 07             SHLD SEED
0052 AF                   XRA A
0053 32 1D 07             STA LASTK
0056 CD 5B 04             CALL SCREEN
0059 21 DB 06             LXI H,M_TITLE
005C CD E8 04             CALL MSG
005F C3 6B 00             JMP WAITST
                  
                  ; ----------------------------------------------------------------------
                  ; Конец игры: сообщение и ожидание СТАРТ
0062 31 C0 07     GOVER:  LXI SP,STACK
0065 21 F8 06             LXI H,M_OVER
0068 CD E8 04             CALL MSG
006B CD 80 05     WAITST: CALL FDELAY
006E CD 8A 05             CALL RND                ; ГСЧ крутится, пока игрок не нажмёт СТАРТ
0071 CD 5F 05             CALL GETKEY
0074 FE 1A                CPI K_START
0076 CA 84 00             JZ NEWG
0079 FE 13                CPI K_MENU
007B CA 81 00             JZ EXIT
007E C3 6B 00             JMP WAITST
                  
0081 C3 00 20     EXIT:   JMP MAIN
                  
                  ; ----------------------------------------------------------------------
                  ; Новая игра
0084 31 C0 07     NEWG:   LXI SP,STACK
0087 CD 5B 04             CALL SCREEN
008A CD A1 05             CALL RND7
008D 32 28 07             STA NT
0090 CD BA 01             CALL SPAWN
                  
                  ; ----------------------------------------------------------------------
                  ; Главный цикл: один проход — один кадр
0093 CD 80 05     LOOP:   CALL FDELAY
0096 CD 33 05             CALL KSCAN
0099 47                   MOV B,A
009A 3A 1D 07             LDA LASTK
009D B8                   CMP B
009E CA BC 00             JZ LPHELD
00A1 78                   MOV A,B                 ; новое нажатие (или отпускание)
00A2 32 1D 07             STA LASTK
00A5 B7                   ORA A
00A6 CA EA 00             JZ LPGRAV
00A9 FE 85                CPI K_DOWN
00AB 3E 0A                MVI A,DAS
00AD C2 B2 00             JNZ LP1
00B0 3E 02                MVI A,SDR
00B2 32 1E 07     LP1:    STA REP
00B5 78                   MOV A,B
00B6 CD 00 01             CALL ACTION
00B9 C3 EA 00             JMP LPGRAV
                  
00BC B7           LPHELD: ORA A                   ; та же клавиша держится: автоповтор
00BD CA EA 00             JZ LPGRAV
00C0 FE 87                CPI K_LEFT
00C2 CA CF 00             JZ LPREP
00C5 FE 82                CPI K_RIGHT
00C7 CA CF 00             JZ LPREP
00CA FE 85                CPI K_DOWN
00CC C2 EA 00             JNZ LPGRAV
00CF 3A 1E 07     LPREP:  LDA REP
00D2 3D                   DCR A
00D3 32 1E 07             STA REP
00D6 C2 EA 00             JNZ LPGRAV
00D9 78                   MOV A,B
00DA FE 85                CPI K_DOWN
00DC 3E 03                MVI A,ARR
00DE C2 E3 00             JNZ LP2
00E1 3E 02                MVI A,SDR
00E3 32 1E 07     LP2:    STA REP
00E6 78                   MOV A,B
00E7 CD 00 01             CALL ACTION
                  
00EA 3A 1F 07     LPGRAV: LDA GCNT                ; падение
00ED 3D                   DCR A
00EE 32 1F 07             STA GCNT
00F1 C2 93 00             JNZ LOOP
00F4 3A 20 07             LDA SPEED
00F7 32 1F 07             STA GCNT
00FA CD A8 01             CALL DOWN1
00FD C3 93 00             JMP LOOP
                  
                  ; ----------------------------------------------------------------------
                  ; Действие по коду клавиши в A
0100 FE 87        ACTION: CPI K_LEFT
0102 CA 4A 01             JZ MLEFT
0105 FE 82                CPI K_RIGHT
0107 CA 51 01             JZ MRIGHT
010A FE 84                CPI K_UP
010C CA 58 01             JZ ROTCW
010F FE 81                CPI K_UR
0111 CA 58 01             JZ ROTCW
0114 FE 86                CPI K_UL
0116 CA 5D 01             JZ ROTCCW
0119 FE 85                CPI K_DOWN
011B CA 84 01             JZ SDROP
011E FE 10                CPI K_DROP
0120 CA 8D 01             JZ HDROP
0123 FE 1A                CPI K_START
0125 CA 2E 01             JZ PAUSE
0128 FE 13                CPI K_MENU
012A CA 81 00             JZ EXIT
012D C9                   RET
                  
012E 21 EE 06     PAUSE:  LXI H,M_PAUSE
0131 CD E8 04             CALL MSG
0134 CD 80 05     PA1:    CALL FDELAY
0137 CD 5F 05             CALL GETKEY
013A FE 1A                CPI K_START
013C CA 47 01             JZ PA2
013F FE 13                CPI K_MENU
0141 CA 81 00             JZ EXIT
0144 C3 34 01             JMP PA1
0147 C3 FA 04     PA2:    JMP CLRMSG
                  
014A CD EB 01     MLEFT:  CALL SETT
014D 35                   DCR M                   ; SETT оставляет HL = TX
014E C3 FF 01             JMP TRY
                  
0151 CD EB 01     MRIGHT: CALL SETT
0154 34                   INR M
0155 C3 FF 01             JMP TRY
                  
0158 06 01        ROTCW:  MVI B,1
015A C3 5F 01             JMP ROT
015D 06 03        ROTCCW: MVI B,3
015F CD EB 01     ROT:    CALL SETT
0162 3A 24 07             LDA PR
0165 80                   ADD B
0166 E6 03                ANI 3
0168 32 27 07             STA TR
016B 21 2D 06             LXI H,KICKS             ; пробуем сдвиги 0, -1, +1, -2, +2
016E 7E           ROT1:   MOV A,M
016F FE 80                CPI 80H
0171 C8                   RZ
0172 E5                   PUSH H
0173 47                   MOV B,A
0174 3A 22 07             LDA PX
0177 80                   ADD B
0178 32 25 07             STA TX
017B CD FF 01             CALL TRY
017E E1                   POP H
017F C8                   RZ
0180 23                   INX H
0181 C3 6E 01             JMP ROT1
                  
0184 3A 20 07     SDROP:  LDA SPEED
0187 32 1F 07             STA GCNT
018A C3 A8 01             JMP DOWN1
                  
                  ; Сброс до упора
018D AF           HDROP:  XRA A
018E CD 6A 02             CALL DRAWP              ; стереть, чтобы не мешала сама себе
0191 CD EB 01             CALL SETT
0194 21 26 07     HD1:    LXI H,TY
0197 34                   INR M
0198 CD 1A 02             CALL FITS
019B CA 94 01             JZ HD1
019E 21 26 07             LXI H,TY
01A1 35                   DCR M
01A2 CD FF 01             CALL TRY
01A5 C3 B1 01             JMP LOCKP
                  
                  ; Шаг вниз; если некуда — фигура ложится, новая фигура
01A8 CD EB 01     DOWN1:  CALL SETT
01AB 23                   INX H
01AC 34                   INR M                   ; TY
01AD CD FF 01             CALL TRY
01B0 C8                   RZ
01B1 CD 6E 05     LOCKP:  CALL CLICK              ; фигура остаётся нарисованной — это и есть стакан
01B4 CD 8E 02             CALL CLRLN
01B7 C3 BA 01             JMP SPAWN
                  
                  ; Новая фигура вверху стакана; не помещается — конец игры
01BA 3A 28 07     SPAWN:  LDA NT
01BD 32 21 07             STA PT
01C0 CD A1 05             CALL RND7
01C3 32 28 07             STA NT
01C6 21 04 00             LXI H,0004H             ; PX=4, PY=0
01C9 22 22 07             SHLD PX
01CC 22 25 07             SHLD TX
01CF AF                   XRA A
01D0 32 24 07             STA PR
01D3 32 27 07             STA TR
01D6 CD FF 03             CALL PREVIEW
01D9 CD 1A 02             CALL FITS
01DC C2 62 00             JNZ GOVER
01DF 3E 01                MVI A,1
01E1 CD 6A 02             CALL DRAWP
01E4 3A 20 07             LDA SPEED
01E7 32 1F 07             STA GCNT
01EA C9                   RET
                  
                  ; ----------------------------------------------------------------------
                  ; Фигура: PT — тип 0..6, PR — поворот, PX/PY — левый верхний угол рамки
                  ; 4x4 в клетках стакана. TX/TY/TR — проверяемое положение.
                  
                  ; T <- P; на выходе HL = TX
01EB 21 22 07     SETT:   LXI H,PX
01EE 11 25 07             LXI D,TX
01F1 0E 03        COPY3:  MVI C,3
01F3 7E           CP1:    MOV A,M
01F4 12                   STAX D
01F5 23                   INX H
01F6 13                   INX D
01F7 0D                   DCR C
01F8 C2 F3 01             JNZ CP1
01FB 21 25 07             LXI H,TX
01FE C9                   RET
                  
                  ; Перенести фигуру в TX/TY/TR, если там свободно. Z — получилось.
01FF AF           TRY:    XRA A
0200 CD 6A 02             CALL DRAWP              ; стереть, чтобы не мешала сама себе
0203 CD 1A 02             CALL FITS
0206 F5                   PUSH PSW
0207 C2 13 02             JNZ TR1
020A 21 25 07             LXI H,TX
020D 11 22 07             LXI D,PX
0210 CD F1 01             CALL COPY3
0213 3E 01        TR1:    MVI A,1
0215 CD 6A 02             CALL DRAWP
0218 F1                   POP PSW
0219 C9                   RET
                  
                  ; Проверка положения TX/TY/TR. Z (A=0) — свободно.
                  ; Отдельного массива стакана нет: занятость клетки читается из видеоОЗУ
                  ; (первый байт кубика 0FFH, пустой клетки — 0). Текущая фигура должна быть стёрта.
021A 3A 27 07     FITS:   LDA TR
021D CD 59 02             CALL SHPTR
0220 0E 04                MVI C,4
0222 11 25 07     FT1:    LXI D,TX
0225 CD 48 02             CALL CELLXY
0228 FE 14                CPI 20                  ; дно
022A D2 44 02             JNC FTBAD
022D 57                   MOV D,A
022E 78                   MOV A,B
022F 3D                   DCR A                   ; столбцы 1..10
0230 FE 0A                CPI 10
0232 D2 44 02             JNC FTBAD
0235 7A                   MOV A,D
0236 E5                   PUSH H
0237 CD C4 03             CALL CELLA
023A 7E                   MOV A,M
023B E1                   POP H
023C B7                   ORA A
023D C0                   RNZ
023E 23                   INX H
023F 0D                   DCR C
0240 C2 22 02             JNZ FT1
0243 C9                   RET
0244 3E 01        FTBAD:  MVI A,1
0246 B7                   ORA A
0247 C9                   RET
                  
                  ; Клетка фигуры: (HL) = dy*16+dx, DE -> X, Y (PX/PY или TX/TY)
                  ; -> B = X+dx, A = Y+dy. HL, C не портит.
0248 1A           CELLXY: LDAX D
0249 86                   ADD M
024A E6 0F                ANI 0FH                 ; X+dx (X от -3 до 12 — по модулю 16)
024C 47                   MOV B,A
024D 13                   INX D
024E 7E                   MOV A,M
024F 0F                   RRC
0250 0F                   RRC
0251 0F                   RRC
0252 0F                   RRC
0253 E6 0F                ANI 0FH
0255 EB                   XCHG
0256 86                   ADD M
0257 EB                   XCHG
0258 C9                   RET
                  
                  ; HL = SHAPES + (тип*4 + поворот)*4.  SHPTR: A = поворот, тип из PT;
                  ; SHPTR2: A = тип, B = поворот.
0259 47           SHPTR:  MOV B,A
025A 3A 21 07             LDA PT
025D 87           SHPTR2: ADD A
025E 87                   ADD A
025F 80                   ADD B
0260 87                   ADD A
0261 87                   ADD A
0262 5F                   MOV E,A
0263 16 00                MVI D,0
0265 21 BD 05             LXI H,SHAPES
0268 19                   DAD D
0269 C9                   RET
                  
                  ; Нарисовать (A<>0) или стереть (A=0) текущую фигуру
026A 32 29 07     DRAWP:  STA FILL
026D 3A 24 07             LDA PR
0270 CD 59 02             CALL SHPTR
0273 0E 04                MVI C,4
0275 11 22 07     DP1:    LXI D,PX
0278 CD 48 02             CALL CELLXY
027B E5                   PUSH H
027C C5                   PUSH B
027D CD C4 03             CALL CELLA
0280 3A 29 07             LDA FILL
0283 CD DE 03             CALL BLK
0286 C1                   POP B
0287 E1                   POP H
0288 23                   INX H
0289 0D                   DCR C
028A C2 75 02             JNZ DP1
028D C9                   RET
                  
                  ; ----------------------------------------------------------------------
                  ; Стакан
                  
                  ; Убрать заполненные строки, начислить очки
028E AF           CLRLN:  XRA A
028F 32 2A 07             STA NCLR
0292 3E 13                MVI A,19
0294 32 2B 07             STA CROW
0297 06 0A        CL1:    MVI B,10
0299 3A 2B 07     CL2:    LDA CROW
029C CD C4 03             CALL CELLA
029F 7E                   MOV A,M
02A0 B7                   ORA A
02A1 CA B5 02             JZ CL4
02A4 05                   DCR B
02A5 C2 99 02             JNZ CL2
02A8 21 2A 07             LXI H,NCLR              ; строка заполнена
02AB 34                   INR M
02AC 3A 2B 07             LDA CROW
02AF CD 0B 03             CALL DELROW
02B2 C3 97 02             JMP CL1                 ; ту же строку — ещё раз
02B5 21 2B 07     CL4:    LXI H,CROW
02B8 35                   DCR M
02B9 F2 97 02             JP CL1
02BC 3A 2A 07             LDA NCLR
02BF B7                   ORA A
02C0 C8                   RZ
                          ; очки: PTS[n-1] * (уровень+1)
02C1 3D                   DCR A
02C2 87                   ADD A
02C3 5F                   MOV E,A
02C4 16 00                MVI D,0
02C6 21 33 06             LXI H,PTS
02C9 19                   DAD D
02CA 5E                   MOV E,M
02CB 23                   INX H
02CC 56                   MOV D,M
02CD 3A 33 07             LDA LEVEL
02D0 3C                   INR A
02D1 4F                   MOV C,A
02D2 CD 5D 03     CL5:    CALL ADDSC
02D5 0D                   DCR C
02D6 C2 D2 02             JNZ CL5
                          ; линии (BCD)
02D9 21 30 07             LXI H,LINES
02DC 3A 2A 07             LDA NCLR
02DF 86                   ADD M
02E0 27                   DAA
02E1 77                   MOV M,A
02E2 23                   INX H
02E3 7E                   MOV A,M
02E4 CE 00                ACI 0
02E6 27                   DAA
02E7 77                   MOV M,A
                          ; уровень — каждые 10 линий
02E8 3A 2A 07             LDA NCLR
02EB 47                   MOV B,A
02EC 3A 32 07             LDA LCNT
02EF 90                   SUB B
02F0 32 32 07             STA LCNT
02F3 CA F9 02             JZ CL6
02F6 F2 08 03             JP CL7
02F9 C6 0A        CL6:    ADI 10
02FB 32 32 07             STA LCNT
02FE 3A 33 07             LDA LEVEL
0301 3C                   INR A
0302 32 33 07             STA LEVEL
0305 CD 70 03             CALL SETSPD
0308 C3 89 03     CL7:    JMP SHOWST
                  
                  ; Удалить строку A: всё, что выше, сдвинуть на строку вниз прямо в видеоОЗУ.
                  ; Вниз по экрану — к младшим адресам, поэтому копируем от младших к старшим.
030B F5           DELROW: PUSH PSW
030C 06 0A                MVI B,10
030E CD C4 03             CALL CELLA
0311 11 E3 FD             LXI D,-(ROWB*(CELLH-1)+1)
0314 19                   DAD D                   ; HL — самый младший адрес строки стакана
0315 F1                   POP PSW
0316 47                   MOV B,A
0317 87                   ADD A
0318 80                   ADD B
0319 87                   ADD A
031A 87                   ADD A
031B 80                   ADD B                   ; 13*строка экранных строк
031C CA 3A 03             JZ DR3
031F 4F                   MOV C,A
0320 E5           DR1:    PUSH H
0321 11 49 02             LXI D,ROWB*CELLH
0324 19                   DAD D                   ; HL — та же строка клетками выше
0325 D1                   POP D
0326 D5                   PUSH D
0327 06 14                MVI B,20
0329 7E           DR2:    MOV A,M
032A 12                   STAX D
032B 23                   INX H
032C 13                   INX D
032D 05                   DCR B
032E C2 29 03             JNZ DR2
0331 E1                   POP H
0332 11 2D 00             LXI D,ROWB
0335 19                   DAD D
0336 0D                   DCR C
0337 C2 20 03             JNZ DR1
033A 06 0A        DR3:    MVI B,10                ; верхняя строка — пустая
033C AF           DR4:    XRA A
033D CD C4 03             CALL CELLA
0340 AF                   XRA A
0341 C5                   PUSH B
0342 CD DE 03             CALL BLK
0345 C1                   POP B
0346 05                   DCR B
0347 C2 3C 03             JNZ DR4
034A C9                   RET
                  
                  ; ----------------------------------------------------------------------
                  ; Счёт
                  
034B 21 2D 07     CLRST:  LXI H,SCORE               ; SCORE, LINES, LCNT, LEVEL
034E 06 07                MVI B,7
0350 36 00        CS1:    MVI M,0
0352 23                   INX H
0353 05                   DCR B
0354 C2 50 03             JNZ CS1
0357 3E 0A                MVI A,10
0359 32 32 07             STA LCNT
035C C9                   RET
                  
                  ; SCORE += DE (BCD); C, D, E не портит
035D 21 2D 07     ADDSC:  LXI H,SCORE
0360 7E                   MOV A,M
0361 83                   ADD E
0362 27                   DAA
0363 77                   MOV M,A
0364 23                   INX H
0365 7E                   MOV A,M
0366 8A                   ADC D
0367 27                   DAA
0368 77                   MOV M,A
0369 23                   INX H
036A 7E                   MOV A,M
036B CE 00                ACI 0
036D 27                   DAA
036E 77                   MOV M,A
036F C9                   RET
                  
0370 3A 33 07     SETSPD: LDA LEVEL
0373 FE 0F                CPI 15
0375 DA 7A 03             JC SS1
0378 3E 0F                MVI A,15
037A 5F           SS1:    MOV E,A
037B 16 00                MVI D,0
037D 21 3B 06             LXI H,GTAB
0380 19                   DAD D
0381 7E                   MOV A,M
0382 32 20 07             STA SPEED
0385 32 1F 07             STA GCNT
0388 C9                   RET
                  
0389 21 2F 07     SHOWST: LXI H,SCORE+2
038C 0E 03                MVI C,3
038E 11 70 F5             LXI D,P_SCORE
0391 CD 1A 05             CALL PBCD
0394 21 31 07             LXI H,LINES+1
0397 0E 02                MVI C,2
0399 11 1C EF             LXI D,P_LINES
039C CD 1A 05             CALL PBCD
039F 3A 33 07             LDA LEVEL               ; уровень -> BCD
03A2 06 00                MVI B,0
03A4 FE 0A        SH1:    CPI 10
03A6 DA AF 03             JC SH2
03A9 D6 0A                SUI 10
03AB 04                   INR B
03AC C3 A4 03             JMP SH1
03AF 4F           SH2:    MOV C,A
03B0 78                   MOV A,B
03B1 07                   RLC
03B2 07                   RLC
03B3 07                   RLC
03B4 07                   RLC
03B5 B1                   ORA C
03B6 32 2C 07             STA TMP
03B9 21 2C 07             LXI H,TMP
03BC 0E 01                MVI C,1
03BE 11 C8 E8             LXI D,P_LEVEL
03C1 C3 1A 05             JMP PBCD
                  
                  ; ----------------------------------------------------------------------
                  ; Графика
                  
                  ; Клетка стакана: A = строка, B = столбец -> HL = адрес на экране
                  ; (ROW0 - 45*13*строка - 2*столбец)
03C4 21 BA FB     CELLA:  LXI H,ROW0
03C7 11 B7 FD             LXI D,-ROWB*CELLH
03CA 3C                   INR A
03CB 3D           CA1:    DCR A
03CC CA D3 03             JZ CA2
